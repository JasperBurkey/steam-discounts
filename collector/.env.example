# Copy to .env and fill in. Never commit .env or share it.
STEAM_API_KEY=
# Optional: Twitch viewership (register an app at dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: alerts when a job fails or goes stale, e.g. https://ntfy.sh/<a-long-random-topic>
ALERT_WEBHOOK_URL=
# Optional: dead man's switch. Create a check at healthchecks.io (period 1 hour, grace 3 hours)
# and paste its ping URL here. You get an alert if the collector stops running at all.
HEARTBEAT_URL=
# Optional: put data somewhere other than ./data
# STEAM_DATA_DIR=/mnt/storage/steam
